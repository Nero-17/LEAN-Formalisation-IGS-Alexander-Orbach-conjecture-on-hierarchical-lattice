  (lower upper : ℝ),
  1 ≤ lower →
    upper ≤ 2 →
      lower < upper →
        ∃ base,
          1 < base ∧
            ∃ length,
              (IGSIII4.SpectralDensity.ActualFamily.appendixRule base (max length 2)).Classical ∧
                (IGSIII4.SpectralDensity.ActualFamily.appendixRule base (max length 2)).network.fullGraph.dist
                      (IGSIII4.SpectralDensity.ActualFamily.appendixRule base (max length 2)).network.source
                      (IGSIII4.SpectralDensity.ActualFamily.appendixRule base (max length 2)).network.target =
                    2 ∧
                  (IGSIII4.SpectralDensity.ActualFamily.appendixRule base (max length 2)).network.fullGraph.degree
                        (IGSIII4.SpectralDensity.ActualFamily.appendixRule base (max length 2)).network.source =
                      2 ∧
                    (IGSIII4.SpectralDensity.ActualFamily.appendixRule base (max length 2)).network.fullGraph.degree
                          (IGSIII4.SpectralDensity.ActualFamily.appendixRule base (max length 2)).network.target =
                        2 ∧
                      (IGSIII4.SpectralDensity.ActualFamily.appendixRule base
                                (max length 2)).network.terminalEdgeConnectivity =
                          2 ∧
                        0 < IGSIII4.SpectralDensity.ActualFamily.appendixCriticalProbability base (max length 2) ∧
