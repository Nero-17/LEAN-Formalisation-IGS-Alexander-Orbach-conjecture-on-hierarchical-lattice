include anchor in
theorem actual_continuous_process_ae_finite_stopping_markov_completion
    (edgePositive : 0 < rule.edges) (growthGreaterThanOne : 1 < growth)
    (degreeLimit : Tendsto (fun depth => levyProkhorovEDist
      (actualElectricalDegreeMeasureCompletion rule p positive belowOne fixedPoint growth value growthPositive
        ⟨marks.val, marks.property.1.1⟩ chemicalScale chemicalScalePositive depth) (measure : Measure (ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩))) atTop (𝓝 0))
    (stationary : ∀ address, electricalCell rule.network (marks.val (address, true))
      (fun edge => electricalField rule p positive belowOne fixedPoint value (address ++ [edge]) marks.val) =
        growth * electricalField rule p positive belowOne fixedPoint value address marks.val)
    (fieldLimit : ∀ address, Tendsto (fun depth => growth⁻¹ ^ depth * electricalIteration rule marks.val depth address) atTop
      (𝓝 (electricalField rule p positive belowOne fixedPoint value address marks.val)))
    (eta coefficient : ℝ) (start : ℕ) (etaNonnegative : 0 ≤ eta) (etaBelowOne : eta < 1)
    (coefficientNonnegative : 0 ≤ coefficient)
    (radiusBound : ∀ address opened depth, start ≤ address.length →
      markedElectricalRadius rule marks.val depth address opened / growth ^ (depth + 1 + address.length) ≤ coefficient * eta ^ address.length)
    (times : ℕ → ℝ≥0) (dense : DenseRange times)
    (initial : ∀ depth, ProbabilityMeasure (ActualFiniteCluster rule (stationaryConfiguration rule marks.val) chemicalScale chemicalScalePositive depth))
    (limitLaw : ProbabilityMeasure (ℕ → ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩))
    (selected : ℕ → ℕ) (selectedAtTop : Tendsto selected atTop atTop)
    (weak : Tendsto (fun depth => actualPaperDiscreteElectricalObservationLawCompletion rule p positive belowOne fixedPoint
      growth value growthPositive ⟨marks.val, marks.property.1.1⟩ chemicalScale chemicalScalePositive times initial (selected depth)) atTop (𝓝 limitLaw))
    (data : ActualSpectralDataCompletion rule p positive belowOne fixedPoint growth value growthPositive
      (harmonicTypicalEnergyMarks rule p positive belowOne fixedPoint growth value marks) anchor
      (measure : Measure (ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩)))
    (time : (ℕ → ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩) → WithTop ℝ≥0)
    (stopping : IsStoppingTime
      (Filtration.natural (fun present path => countableTimeContinuousSampleCompletion times dense path present)
        (fun present => (countableTimeContinuousSample_evaluation_measurable_completion times dense present).stronglyMeasurable))
      time)
    (finiteTime : ∀ᵐ path ∂(limitLaw : Measure _), time path ≠ ⊤)
    (future : ℝ≥0)
    (function : C(ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩, ℝ)) :
    (limitLaw : Measure _)[(fun path => function (countableTimeContinuousSampleCompletion times dense path ((time path).untopA + future))) |
      stopping.measurableSpace] =ᵐ[(limitLaw : Measure _)]
      (fun path => ∫ retained, function retained ∂actualTransitionKernelCompletion rule p positive belowOne fixedPoint
        growth value growthPositive (harmonicTypicalEnergyMarks rule p positive belowOne fixedPoint growth value marks) anchor
        (measure : Measure (ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩)) data future
        (countableTimeContinuousSampleCompletion times dense path (time path).untopA)) := by
  have denseDomain := actualCompletionEnergyDomain_dense rule p positive belowOne fixedPoint growth value growthPositive marks
  let transformed := actualFellerSemigroupCompletion rule p positive belowOne fixedPoint growth value growthPositive
    (harmonicTypicalEnergyMarks rule p positive belowOne fixedPoint growth value marks) anchor
    (measure : Measure (ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩))
    data.basis data.resolventEigenvalues data.eigenvaluesPositive data.eigenvectors data.generatorNonnegative future function
  have markov (present : ℝ≥0) := actual_continuous_process_natural_markov_completion rule p positive belowOne fixedPoint growth value growthPositive
    marks chemicalScale chemicalScalePositive measure anchor edgePositive growthGreaterThanOne degreeLimit stationary fieldLimit
    eta coefficient start etaNonnegative etaBelowOne coefficientNonnegative radiusBound times dense initial limitLaw selected selectedAtTop weak data
    present (present+future) (le_add_right le_rfl) function
  have kernelEquality (point : ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩) :
      (∫ retained, function retained ∂actualTransitionKernelCompletion rule p positive belowOne fixedPoint growth value growthPositive
        (harmonicTypicalEnergyMarks rule p positive belowOne fixedPoint growth value marks) anchor
        (measure : Measure (ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩)) data future point) = transformed point :=
    actualTransitionKernel_continuous_expectation_completion rule p positive belowOne fixedPoint growth value growthPositive
      (harmonicTypicalEnergyMarks rule p positive belowOne fixedPoint growth value marks) anchor
      (measure : Measure (ActualStationaryElectricalSpace rule p positive belowOne fixedPoint growth value growthPositive ⟨marks.val, marks.property.1.1⟩)) data denseDomain future function point
  have actual := aeFiniteStopping_feller_condExp_completion (limitLaw : Measure _)
    (Filtration.natural (fun present path => countableTimeContinuousSampleCompletion times dense path present)
      (fun present => (countableTimeContinuousSample_evaluation_measurable_completion times dense present).stronglyMeasurable))
    (fun present path => countableTimeContinuousSampleCompletion times dense path present)
    (countableTimeContinuousSample_joint_measurable_completion times dense)
    (Filtration.stronglyAdapted_natural (fun present => (countableTimeContinuousSample_evaluation_measurable_completion times dense present).stronglyMeasurable))
    (countableTimeContinuousSample_continuous_completion times dense) time stopping finiteTime future function transformed ?_
  · exact actual.trans (ae_of_all _ fun path => (kernelEquality _).symm)
  · intro present
    have deterministic := markov present
    simp only [add_tsub_cancel_left] at deterministic
    exact deterministic.trans (ae_of_all _ fun path => kernelEquality (countableTimeContinuousSampleCompletion times dense path present))

end
end IGSIII34.Diffusion


