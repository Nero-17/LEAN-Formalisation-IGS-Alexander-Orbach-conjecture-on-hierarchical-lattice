import Mathlib.Topology.EMetricSpace.Defs
import Mathlib.Topology.Order.MonotoneContinuity
import Mathlib.Topology.Instances.Real.Lemmas
import Mathlib.Topology.ContinuousMap.Compact
import Mathlib.Data.ENNReal.Operations

/-! A genuine Skorokhod time-change topology on interval paths. The carrier
is a fresh path wrapper: its topology is generated by the J1 infimum over
increasing interval homeomorphisms, not the product topology. -/
set_option autoImplicit false
set_option maxHeartbeats 1200000
namespace IGSIII34.Diffusion
noncomputable section
open Filter Set
open scoped Topology ENNReal NNReal

abbrev SkorokhodIntervalTimeCompletion := Set.Icc (0 : ℝ) 1

structure SkorokhodIntervalPathCompletion (Space : Type*) where
  toFun : SkorokhodIntervalTimeCompletion → Space

instance {Space : Type*} : CoeFun (SkorokhodIntervalPathCompletion Space)
    (fun _ => SkorokhodIntervalTimeCompletion → Space) := ⟨fun path => path.toFun⟩

variable {Space : Type*} [MetricSpace Space]

def skorokhodTimeChangeErrorCompletion
    (first second : SkorokhodIntervalPathCompletion Space)
    (change : SkorokhodIntervalTimeCompletion ≃o SkorokhodIntervalTimeCompletion) : ℝ≥0∞ :=
  max (⨆ time, edist (change time) time) (⨆ time, edist (first (change time)) (second time))

def skorokhodJ1EDistCompletion
    (first second : SkorokhodIntervalPathCompletion Space) : ℝ≥0∞ :=
  ⨅ change : SkorokhodIntervalTimeCompletion ≃o SkorokhodIntervalTimeCompletion,
    skorokhodTimeChangeErrorCompletion first second change

theorem skorokhodJ1EDist_self_completion
    (path : SkorokhodIntervalPathCompletion Space) :
    skorokhodJ1EDistCompletion path path = 0 := by
  apply le_antisymm _ zero_le
  apply iInf_le_of_le (OrderIso.refl _) 
  simp [skorokhodTimeChangeErrorCompletion]

theorem skorokhodTimeChange_inverse_bound_completion
    (first second : SkorokhodIntervalPathCompletion Space)
    (change : SkorokhodIntervalTimeCompletion ≃o SkorokhodIntervalTimeCompletion) :
    skorokhodTimeChangeErrorCompletion second first change.symm ≤
      skorokhodTimeChangeErrorCompletion first second change := by
  apply max_le
  · apply iSup_le
    intro time
    have bound := le_iSup (fun next => edist (change next) next) (change.symm time)
    simp only [OrderIso.apply_symm_apply] at bound
    have reverseBound : edist (change.symm time) time ≤ ⨆ next, edist (change next) next := by
      simpa only [edist_comm] using bound
    exact reverseBound.trans (le_max_left _ _)
  · apply iSup_le
    intro time
    have bound := le_iSup (fun next => edist (first (change next)) (second next)) (change.symm time)
    simp only [OrderIso.apply_symm_apply] at bound
    have reverseBound : edist (second (change.symm time)) (first time) ≤ ⨆ next, edist (first (change next)) (second next) := by
      simpa only [edist_comm] using bound
    exact reverseBound.trans (le_max_right _ _)

theorem skorokhodJ1EDist_reverse_le_completion
    (first second : SkorokhodIntervalPathCompletion Space) :
    skorokhodJ1EDistCompletion second first ≤ skorokhodJ1EDistCompletion first second := by
  apply le_iInf
  intro change
  exact (iInf_le _ change.symm).trans
    (skorokhodTimeChange_inverse_bound_completion first second change)

theorem skorokhodJ1EDist_comm_completion
    (first second : SkorokhodIntervalPathCompletion Space) :
    skorokhodJ1EDistCompletion first second = skorokhodJ1EDistCompletion second first :=
  le_antisymm (skorokhodJ1EDist_reverse_le_completion second first)
    (skorokhodJ1EDist_reverse_le_completion first second)

theorem skorokhodTimeChange_compose_bound_completion
    (first second third : SkorokhodIntervalPathCompletion Space)
    (firstChange secondChange : SkorokhodIntervalTimeCompletion ≃o SkorokhodIntervalTimeCompletion) :
    skorokhodTimeChangeErrorCompletion first third (secondChange.trans firstChange) ≤
      skorokhodTimeChangeErrorCompletion first second firstChange +
        skorokhodTimeChangeErrorCompletion second third secondChange := by
  apply max_le
  · apply iSup_le
    intro time
    exact (edist_triangle (firstChange (secondChange time)) (secondChange time) time).trans
      (add_le_add ((le_iSup (fun next => edist (firstChange next) next) (secondChange time)).trans (le_max_left _ _))
        ((le_iSup (fun next => edist (secondChange next) next) time).trans (le_max_left _ _)))
  · apply iSup_le
    intro time
    exact (edist_triangle (first (firstChange (secondChange time))) (second (secondChange time)) (third time)).trans
      (add_le_add ((le_iSup (fun next => edist (first (firstChange next)) (second next)) (secondChange time)).trans (le_max_right _ _))
        ((le_iSup (fun next => edist (second (secondChange next)) (third next)) time).trans (le_max_right _ _)))

theorem skorokhodJ1EDist_triangle_completion
    (first second third : SkorokhodIntervalPathCompletion Space) :
    skorokhodJ1EDistCompletion first third ≤
      skorokhodJ1EDistCompletion first second + skorokhodJ1EDistCompletion second third := by
  apply ENNReal.le_iInf_add_iInf
  intro firstChange secondChange
  exact (iInf_le _ (secondChange.trans firstChange)).trans
    (skorokhodTimeChange_compose_bound_completion first second third firstChange secondChange)

instance skorokhodJ1PseudoEMetricCompletion :
    PseudoEMetricSpace (SkorokhodIntervalPathCompletion Space) :=
  PseudoEMetricSpace.ofEDist skorokhodJ1EDistCompletion
    skorokhodJ1EDist_self_completion skorokhodJ1EDist_comm_completion
      skorokhodJ1EDist_triangle_completion

theorem skorokhodJ1EDist_le_uniform_completion
    (first second : SkorokhodIntervalPathCompletion Space) :
    edist first second ≤ ⨆ time, edist (first time) (second time) := by
  change skorokhodJ1EDistCompletion first second ≤ _
  apply iInf_le_of_le (OrderIso.refl _)
  simp [skorokhodTimeChangeErrorCompletion]

def continuousIntervalPathCompletion
    (path : C(SkorokhodIntervalTimeCompletion, Space)) : SkorokhodIntervalPathCompletion Space := ⟨path⟩

theorem continuousIntervalPath_lipschitz_completion :
    LipschitzWith 1 (continuousIntervalPathCompletion (Space := Space)) := by
  apply LipschitzWith.of_edist_le
  intro first second
  simpa only [ENNReal.coe_one, one_mul, ContinuousMap.edist_eq_iSup, continuousIntervalPathCompletion] using
    skorokhodJ1EDist_le_uniform_completion (continuousIntervalPathCompletion first)
      (continuousIntervalPathCompletion second)

end
end IGSIII34.Diffusion


