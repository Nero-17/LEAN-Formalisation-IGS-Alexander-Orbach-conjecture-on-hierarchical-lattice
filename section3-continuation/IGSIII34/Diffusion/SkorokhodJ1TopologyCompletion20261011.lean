import Mathlib.Topology.EMetricSpace.Defs
import Mathlib.Topology.Order.MonotoneContinuity
import Mathlib.Topology.Instances.Real.Lemmas
import Mathlib.Topology.ContinuousMap.Compact
import Mathlib.Data.ENNReal.Operations

/-! A genuine Skorokhod time-change topology on interval paths. The carrier
is a fresh path wrapper: its topology is generated by the J1 infimum over
increasing interval homeomorphisms, not the product topology. -/
set_option autoImplicit false
set_option maxHeartbeats 1200000
namespace IGSIII34.Diffusion
noncomputable section
open Filter Set
open scoped Topology ENNReal NNReal

abbrev SkorokhodIntervalTimeCompletion20261011 := Set.Icc (0 : ℝ) 1

structure SkorokhodIntervalPathCompletion20261011 (Space : Type*) where
  toFun : SkorokhodIntervalTimeCompletion20261011 → Space

instance {Space : Type*} : CoeFun (SkorokhodIntervalPathCompletion20261011 Space)
    (fun _ => SkorokhodIntervalTimeCompletion20261011 → Space) := ⟨fun path => path.toFun⟩

variable {Space : Type*} [MetricSpace Space]

def skorokhodTimeChangeErrorCompletion20261011
    (first second : SkorokhodIntervalPathCompletion20261011 Space)
    (change : SkorokhodIntervalTimeCompletion20261011 ≃o SkorokhodIntervalTimeCompletion20261011) : ℝ≥0∞ :=
  max (⨆ time, edist (change time) time) (⨆ time, edist (first (change time)) (second time))

def skorokhodJ1EDistCompletion20261011
    (first second : SkorokhodIntervalPathCompletion20261011 Space) : ℝ≥0∞ :=
  ⨅ change : SkorokhodIntervalTimeCompletion20261011 ≃o SkorokhodIntervalTimeCompletion20261011,
    skorokhodTimeChangeErrorCompletion20261011 first second change

theorem skorokhodJ1EDist_self_completion20261011
    (path : SkorokhodIntervalPathCompletion20261011 Space) :
    skorokhodJ1EDistCompletion20261011 path path = 0 := by
  apply le_antisymm _ zero_le
  apply iInf_le_of_le (OrderIso.refl _) 
  simp [skorokhodTimeChangeErrorCompletion20261011]

theorem skorokhodTimeChange_inverse_bound_completion20261011
    (first second : SkorokhodIntervalPathCompletion20261011 Space)
    (change : SkorokhodIntervalTimeCompletion20261011 ≃o SkorokhodIntervalTimeCompletion20261011) :
    skorokhodTimeChangeErrorCompletion20261011 second first change.symm ≤
      skorokhodTimeChangeErrorCompletion20261011 first second change := by
  apply max_le
  · apply iSup_le
    intro time
    have bound := le_iSup (fun next => edist (change next) next) (change.symm time)
    simp only [OrderIso.apply_symm_apply] at bound
    have reverseBound : edist (change.symm time) time ≤ ⨆ next, edist (change next) next := by
      simpa only [edist_comm] using bound
    exact reverseBound.trans (le_max_left _ _)
  · apply iSup_le
    intro time
    have bound := le_iSup (fun next => edist (first (change next)) (second next)) (change.symm time)
    simp only [OrderIso.apply_symm_apply] at bound
    have reverseBound : edist (second (change.symm time)) (first time) ≤ ⨆ next, edist (first (change next)) (second next) := by
      simpa only [edist_comm] using bound
    exact reverseBound.trans (le_max_right _ _)

theorem skorokhodJ1EDist_reverse_le_completion20261011
    (first second : SkorokhodIntervalPathCompletion20261011 Space) :
    skorokhodJ1EDistCompletion20261011 second first ≤ skorokhodJ1EDistCompletion20261011 first second := by
  apply le_iInf
  intro change
  exact (iInf_le _ change.symm).trans
    (skorokhodTimeChange_inverse_bound_completion20261011 first second change)

theorem skorokhodJ1EDist_comm_completion20261011
    (first second : SkorokhodIntervalPathCompletion20261011 Space) :
    skorokhodJ1EDistCompletion20261011 first second = skorokhodJ1EDistCompletion20261011 second first :=
  le_antisymm (skorokhodJ1EDist_reverse_le_completion20261011 second first)
    (skorokhodJ1EDist_reverse_le_completion20261011 first second)

theorem skorokhodTimeChange_compose_bound_completion20261011
    (first second third : SkorokhodIntervalPathCompletion20261011 Space)
    (firstChange secondChange : SkorokhodIntervalTimeCompletion20261011 ≃o SkorokhodIntervalTimeCompletion20261011) :
    skorokhodTimeChangeErrorCompletion20261011 first third (secondChange.trans firstChange) ≤
      skorokhodTimeChangeErrorCompletion20261011 first second firstChange +
        skorokhodTimeChangeErrorCompletion20261011 second third secondChange := by
  apply max_le
  · apply iSup_le
    intro time
    exact (edist_triangle (firstChange (secondChange time)) (secondChange time) time).trans
      (add_le_add ((le_iSup (fun next => edist (firstChange next) next) (secondChange time)).trans (le_max_left _ _))
        ((le_iSup (fun next => edist (secondChange next) next) time).trans (le_max_left _ _)))
  · apply iSup_le
    intro time
    exact (edist_triangle (first (firstChange (secondChange time))) (second (secondChange time)) (third time)).trans
      (add_le_add ((le_iSup (fun next => edist (first (firstChange next)) (second next)) (secondChange time)).trans (le_max_right _ _))
        ((le_iSup (fun next => edist (second (secondChange next)) (third next)) time).trans (le_max_right _ _)))

theorem skorokhodJ1EDist_triangle_completion20261011
    (first second third : SkorokhodIntervalPathCompletion20261011 Space) :
    skorokhodJ1EDistCompletion20261011 first third ≤
      skorokhodJ1EDistCompletion20261011 first second + skorokhodJ1EDistCompletion20261011 second third := by
  apply ENNReal.le_iInf_add_iInf
  intro firstChange secondChange
  exact (iInf_le _ (secondChange.trans firstChange)).trans
    (skorokhodTimeChange_compose_bound_completion20261011 first second third firstChange secondChange)

instance skorokhodJ1PseudoEMetricCompletion20261011 :
    PseudoEMetricSpace (SkorokhodIntervalPathCompletion20261011 Space) :=
  PseudoEMetricSpace.ofEDist skorokhodJ1EDistCompletion20261011
    skorokhodJ1EDist_self_completion20261011 skorokhodJ1EDist_comm_completion20261011
      skorokhodJ1EDist_triangle_completion20261011

theorem skorokhodJ1EDist_le_uniform_completion20261011
    (first second : SkorokhodIntervalPathCompletion20261011 Space) :
    edist first second ≤ ⨆ time, edist (first time) (second time) := by
  change skorokhodJ1EDistCompletion20261011 first second ≤ _
  apply iInf_le_of_le (OrderIso.refl _)
  simp [skorokhodTimeChangeErrorCompletion20261011]

def continuousIntervalPathCompletion20261011
    (path : C(SkorokhodIntervalTimeCompletion20261011, Space)) : SkorokhodIntervalPathCompletion20261011 Space := ⟨path⟩

theorem continuousIntervalPath_lipschitz_completion20261011 :
    LipschitzWith 1 (continuousIntervalPathCompletion20261011 (Space := Space)) := by
  apply LipschitzWith.of_edist_le
  intro first second
  simpa only [ENNReal.coe_one, one_mul, ContinuousMap.edist_eq_iSup, continuousIntervalPathCompletion20261011] using
    skorokhodJ1EDist_le_uniform_completion20261011 (continuousIntervalPathCompletion20261011 first)
      (continuousIntervalPathCompletion20261011 second)

end
end IGSIII34.Diffusion


